{
  "standard.version": "0.4",
  "file_globs": [
    "crates/**/*.rs",
    "tools/**/*.rs"
  ],
  "fail_on": [
    0,
    1
  ],
  "rules": {
    "CEP-LINT-FILE-HEADER": {
      "severity": 1,
      "check": "comment_block_schema",
      "params": {
        "max_start_line": 1
      }
    },
    "CEP-LINT-FUNC-BLOCK": {
      "severity": 1,
      "check": "function_policy",
      "params": {
        "min_body_statements": 5
      }
    },
    "CEP-LINT-STATUS-VALUE": {
      "severity": 2,
      "check": "comment_block_schema",
      "params": {}
    },
    "CEP-LINT-TODO-OWNER": {
      "severity": 1,
      "check": "comment_regex",
      "params": {
        "exempt_paths": [
          "tools/cep_lint/src/rules.rs"
        ]
      }
    },
    "CEP-LINT-STUB-DECL": {
      "severity": 1,
      "check": "comment_block_schema",
      "params": {}
    },
    "CEP-LINT-PLACEHOLDER-COMMENT": {
      "severity": 1,
      "check": "comment_regex",
      "params": {
        "exempt_paths": [
          "tools/cep_lint/src/rules.rs"
        ]
      }
    },
    "CEP-LINT-PLACEHOLDER-TEXT": {
      "severity": 1,
      "check": "string_literal_regex",
      "params": {
        "exempt_paths": [
          "tools/cep_lint/src/rules.rs"
        ]
      }
    },
    "CEP-LINT-MAGIC-NUMBER": {
      "severity": 2,
      "check": "numeric_literal_policy",
      "params": {
        "dialects": [
          "cpp"
        ],
        "allowed_values": [
          0,
          1
        ]
      }
    },
    "CEP-LINT-MACRO-PREFIX": {
      "severity": 2,
      "check": "macro_prefix_policy",
      "params": {}
    },
    "CEP-LINT-HOT-BANNED": {
      "severity": 0,
      "check": "banned_token_policy",
      "params": {
        "dialects": [
          "cpp"
        ]
      }
    },
    "CEP-LINT-STUB-BODY": {
      "severity": 1,
      "check": "function_policy",
      "params": {}
    },
    "CEP-LINT-EMPTY-CATCH": {
      "severity": 1,
      "check": "flat_code_regex",
      "params": {
        "dialects": [
          "cpp"
        ]
      }
    },
    "CEP-LINT-EMPTY-BRANCH": {
      "severity": 2,
      "check": "flat_code_regex",
      "params": {}
    },
    "CEP-LINT-CONSTANT-RETURN": {
      "severity": 2,
      "check": "function_policy",
      "params": {
        "dialects": [
          "cpp"
        ]
      }
    },
    "CEP-LINT-NAMING-TYPE": {
      "severity": 2,
      "check": "flat_code_regex",
      "params": {}
    },
    "CEP-LINT-NAMING-FUNC": {
      "severity": 2,
      "check": "function_policy",
      "params": {}
    },
    "CEP-LINT-COMMENTED-CODE": {
      "severity": 2,
      "check": "comment_regex",
      "params": {}
    },
    "CEP-LINT-DOC-SYNC": {
      "severity": 1,
      "check": "doc_rule_coverage",
      "params": {
        "doc_path": "standard.md"
      }
    },
    "CEP-LINT-HUNT-RECEIPT": {
      "severity": 0,
      "check": "commit_hunt_manifest",
      "params": {}
    },
    "CEP-LINT-HUNTER-RECEIPT": {
      "severity": 0,
      "check": "hunter_manifest",
      "params": {}
    }
  }
}
