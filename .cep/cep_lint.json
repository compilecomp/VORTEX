{
  "standard.version": "0.4",
  "file_globs": [
    "crates/**/*.rs",
    "tools/**/*.rs"
  ],
  "fail_on": [
    0,
    1
  ],
  "rules": {
    "CEP-LINT-FILE-HEADER": {
      "severity": 1,
      "check": "comment_block_schema",
      "params": {
        "max_start_line": 1
      }
    },
    "CEP-LINT-FUNC-BLOCK": {
      "severity": 1,
      "check": "function_policy",
      "params": {
        "min_body_statements": 5
      }
    },
    "CEP-LINT-STATUS-VALUE": {
      "severity": 2,
      "check": "comment_block_schema",
      "params": {}
    },
    "CEP-LINT-TODO-OWNER": {
      "severity": 1,
      "check": "comment_regex",
      "params": {
        "exempt_paths": [
          "tools/cep_lint/src/rules.rs"
        ]
      }
    },
    "CEP-LINT-STUB-DECL": {
      "severity": 1,
      "check": "comment_block_schema",
      "params": {}
    },
    "CEP-LINT-PLACEHOLDER-COMMENT": {
      "severity": 1,
      "check": "comment_regex",
      "params": {
        "exempt_paths": [
          "tools/cep_lint/src/rules.rs"
        ]
      }
    },
    "CEP-LINT-PLACEHOLDER-TEXT": {
      "severity": 1,
      "check": "string_literal_regex",
      "params": {
        "exempt_paths": [
          "tools/cep_lint/src/rules.rs"
        ]
      }
    },
    "CEP-LINT-MAGIC-NUMBER": {
      "severity": 2,
      "check": "numeric_literal_policy",
      "params": {
        "dialects": [
          "cpp"
        ],
        "allowed_values": [
          0,
          1
        ]
      }
    },
    "CEP-LINT-MACRO-PREFIX": {
      "severity": 2,
      "check": "macro_prefix_policy",
      "params": {}
    },
    "CEP-LINT-HOT-BANNED": {
      "severity": 0,
      "check": "banned_token_policy",
      "params": {
        "dialects": [
          "cpp"
        ]
      }
    },
    "CEP-LINT-STUB-BODY": {
      "severity": 1,
      "check": "function_policy",
      "params": {}
    },
    "CEP-LINT-EMPTY-CATCH": {
      "severity": 1,
      "check": "flat_code_regex",
      "params": {
        "dialects": [
          "cpp"
        ]
      }
    },
    "CEP-LINT-EMPTY-BRANCH": {
      "severity": 2,
      "check": "flat_code_regex",
      "params": {}
    },
    "CEP-LINT-CONSTANT-RETURN": {
      "severity": 2,
      "check": "function_policy",
      "params": {
        "dialects": [
          "cpp"
        ]
      }
    },
    "CEP-LINT-NAMING-TYPE": {
      "severity": 2,
      "check": "flat_code_regex",
      "params": {}
    },
    "CEP-LINT-NAMING-FUNC": {
      "severity": 2,
      "check": "function_policy",
      "params": {}
    },
    "CEP-LINT-COMMENTED-CODE": {
      "severity": 2,
      "check": "comment_regex",
      "params": {}
    },
    "CEP-LINT-DOC-SYNC": {
      "severity": 1,
      "check": "doc_rule_coverage",
      "params": {
        "doc_path": "standard.md"
      }
    },
    "CEP-LINT-HUNT-RECEIPT": {
      "severity": 0,
      "check": "commit_hunt_manifest",
      "params": {}
    },
    "CEP-LINT-HUNTER-RECEIPT": {
      "severity": 0,
      "check": "hunter_manifest",
      "params": {}
    },
    "CEP-LINT-ATOMIC-FILE": {
      "severity": 1,
      "check": "file_topology_policy",
      "params": {
        "line_limits": {
          "CEP-0": 400,
          "HPC-0": 400,
          "RCS-0": 400,
          "CEP-1": 800,
          "HPC-1": 800,
          "RCS-1": 800,
          "CEP-2": 1200,
          "HPC-2": 1200,
          "RCS-2": 1200,
          "CC": 800,
          "FFI": 800
        },
        "default_limit": 800,
        "junk_names": [
          "util",
          "helper",
          "misc",
          "common"
        ]
      }
    },
    "CEP-LINT-DOC-ID": {
      "severity": 1,
      "check": "function_policy",
      "params": {
        "max_id_statements": 10,
        "id_pattern": "[A-Z]+-[a-z0-9]+"
      }
    },
    "CEP-LINT-DOC-FILE": {
      "severity": 1,
      "check": "rosetta_policy",
      "params": {
        "registry_path": "docs/registry.json",
        "docs_prefix": "docs/functions/"
      }
    },
    "CEP-LINT-DOC-TIERS": {
      "severity": 1,
      "check": "rosetta_policy",
      "params": {}
    },
    "CEP-LINT-DOC-INQUISITION": {
      "severity": 1,
      "check": "rosetta_policy",
      "params": {}
    },
    "CEP-LINT-SECRET-SCAN": {
      "severity": 0,
      "check": "secret_probe_policy",
      "params": {
        "patterns": [
          "password",
          "passwd",
          "secret_key",
          "api_key",
          "apikey",
          "aws_secret_access_key",
          "begin private key",
          "akia"
        ],
        "exempt_paths": [
          "tools/cep_lint/src/rules.rs",
          "tools/cep_lint/tests/engine.rs",
          "tools/cep_lint/tests/receipts.rs"
        ]
      }
    },
    "CEP-LINT-UNSAFE-DOC": {
      "severity": 1,
      "check": "unsafe_doc_policy",
      "params": {
        "exempt_paths": [
          "tools/cep_lint/src/rules.rs",
          "tools/cep_lint/tests/engine.rs",
          "tools/cep_lint/tests/receipts.rs"
        ]
      }
    }
  }
}